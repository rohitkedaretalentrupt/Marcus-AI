# Copy to `.env` for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and are never sent to the browser.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Absolute base URL of the deployment (server-only). Auth.js derives its
# callback URLs from it, and an https:// value enables Secure session cookies.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — server-only
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=postgresql://resume_app:resume_app_dev_password@localhost:5432/resume_app?schema=public

# Optional: a SEPARATE database for integration tests (`npm run db:test:prepare`,
# then `npm test`). Integration tests are skipped when this is empty.
TEST_DATABASE_URL=postgresql://resume_app:resume_app_dev_password@localhost:5432/resume_app_test?schema=public

# ---------------------------------------------------------------------------
# Authentication (Auth.js) — server-only. REQUIRED, at least 32 characters.
# Encrypts session cookies; changing it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# AI provider — SERVER-ONLY (never NEXT_PUBLIC_). Leave AI_PROVIDER empty to
# disable assistant replies. MiMo: https://mimo.mi.com (OpenAI-compatible API).
# ---------------------------------------------------------------------------
AI_PROVIDER=
# To enable MiMo: AI_PROVIDER=mimo and AI_API_KEY=<your MiMo key (sk-...)>
AI_API_KEY=
# Optional overrides — defaults: https://api.xiaomimimo.com/v1 and mimo-v2.6-pro
# Using MiMo through OpenRouter instead: AI_PROVIDER=mimo, AI_API_KEY=<OpenRouter key sk-or-...>,
# AI_BASE_URL=https://openrouter.ai/api/v1 and AI_MODEL=xiaomi/mimo-v2.6-pro (the default for OpenRouter).
AI_BASE_URL=
AI_MODEL=
# Optional tuning: request time limit (ms), max reply tokens, thinking mode.
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
AI_THINKING=disabled

# ---------------------------------------------------------------------------
# File storage — Cloudflare R2 (private bucket). SERVER-ONLY: never prefix
# these with NEXT_PUBLIC_. Leave STORAGE_PROVIDER empty to disable uploads.
# Setup (bucket, scoped API token, CORS): see README → "File uploads (Cloudflare R2)".
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=
# Cloudflare account id; the endpoint becomes https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Optional override of the S3 API endpoint (e.g. an EU-jurisdiction endpoint).
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# DEVELOPMENT ONLY alternative: STORAGE_PROVIDER=local keeps files in a folder on
# this computer (default ./storage, git-ignored) until R2 is set up. Uploads and
# downloads still use short-lived signed links. Refused when NODE_ENV=production.
LOCAL_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Startup & maintenance (server-only)
# ---------------------------------------------------------------------------
# In production (NODE_ENV=production) the server refuses to start unless the AI
# provider AND R2 storage are configured. Set to true only for a deliberately
# partial deployment (e.g. a staging smoke test). Ignored in development.
ALLOW_DISABLED_SERVICES=false
# Hourly in-process cleanup of abandoned/failed/deleted upload objects in R2
# (runs only when storage is configured). Set to false to disable.
STORAGE_CLEANUP=true

# ---------------------------------------------------------------------------
# Public (exposed to the browser at build time — never put secrets here)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Marcus AI
